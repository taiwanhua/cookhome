# 外部安裝 skill 的 symlink(機器特定,由 `npx skills add` / skills-lock.json 重建)
# 自製的專案 skill 直接放 .claude/skills/<名稱>/,會正常版控
.claude/skills/vercel-react-best-practices
.claude/skills/web-design-guidelines
.claude/skills/writing-guidelines

# Storybook build 產物
storybook-static

# Claude Code 背景 agent 的隔離 worktree(機器特定)
.claude/worktrees/

# Claude Code PostToolUse hook 的本機開關(見 scripts/claude-hooks/post-edit-check.mjs)
.claude/hook-typecheck-off

# 從 repo 根跑 api 時 NestJS 會在根目錄誤生一份 schema.gql(正本在 apps/api/schema.gql)
/schema.gql
