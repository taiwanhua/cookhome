MONGODB_URI=mongodb://localhost:27017/cookhome
PORT=5001

# access token 簽章密鑰(必填,缺少即啟動失敗;雲端存 Secret Manager)。本地隨便給一段即可,
# 正式值用 `openssl rand -base64 32` 產生。變數清單與說明見 docs/env-registry.md
JWT_SECRET=local-dev-jwt-secret-change-me

# 以下皆有內建預設值,不設也能跑
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=30d
# COOKIE_DOMAIN=            # 本地不設;雲端 .cookhome.online
