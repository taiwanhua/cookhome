# apps/e2e 的環境變數範本(全部可省略,程式裡有同樣的預設值;要覆寫就複製成 apps/e2e/.env)。
#
# 這裡的帳密全是**測試值**,只會用在本機 / CI 起的拋棄式資料庫上。
# 任何真實環境的密碼、金鑰一律不放這裡,也不放進 e2e.yml 的 inputs —— 那些在 Secret Manager
#(清單見 docs/env-registry.md)。

# admin 與 api 必須同一個主機名(refresh cookie 是 SameSite=Lax,localhost 與 127.0.0.1 算兩個站台)
E2E_HOST=127.0.0.1
E2E_API_PORT=5101
E2E_ADMIN_PORT=4301

# 空 = harness 自起 mongodb-memory-server;CI 填 service container 的位址
# E2E_MONGODB_URI=mongodb://127.0.0.1:27017/cookhome_e2e
E2E_DB_NAME=cookhome_e2e

# seed 建出來的超級管理員(對應 ROOT_ADMIN_ACCOUNT / ROOT_ADMIN_EMAIL / ROOT_ADMIN_PASSWORD)
E2E_ROOT_ACCOUNT=root
E2E_ROOT_EMAIL=e2e-root@cookhome.test
E2E_ROOT_PASSWORD=e2e-root-pw-2026

# 劇本自己建出來的 +tenant / +user 共用密碼(密碼規則:8 碼以上、非純數字)
E2E_MEMBER_PASSWORD=e2e-member-pw-2026

# api 缺 JWT_SECRET 會啟動失敗,e2e 給假值即可
E2E_JWT_SECRET=e2e-only-jwt-secret

# 只跑標題符合的劇本(Playwright 的 grep;空 = 全部)
# E2E_GREP=劇本 7

# 本機反覆跑同一條劇本時的兩個省時開關
# E2E_SKIP_BUILD=1   # 不重新 build api / admin
# E2E_SKIP_STACK=1   # 不起 stack,直接打已經跑著的 api / admin
